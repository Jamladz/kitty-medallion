rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Validate bounded increment on numeric fields safely even if legacy field was null/missing
    function isBoundedIncrement(field, maxDelta) {
      let oldVal = (resource != null && field in resource.data && resource.data[field] is number) ? resource.data[field] : 0;
      let newVal = (field in request.resource.data && request.resource.data[field] is number) ? request.resource.data[field] : oldVal;
      return (newVal - oldVal) <= maxDelta;
    }

    // Helper: Validate claimedMilestones safely even if legacy doc did not have claimedMilestones
    function isValidMilestoneUpdate() {
      let oldList = (resource != null && 'claimedMilestones' in resource.data && resource.data.claimedMilestones is list) ? resource.data.claimedMilestones : [];
      let newList = ('claimedMilestones' in request.resource.data && request.resource.data.claimedMilestones is list) ? request.resource.data.claimedMilestones : oldList;
      return newList.size() <= 10 && (newList.size() == oldList.size() || newList.size() == oldList.size() + 1);
    }

    // Helper: Allow setting referredBy / referrerId on existing or new users while preventing self-referral
    function isReferredByValidTransition(userId) {
      let newRef = ('referredBy' in request.resource.data) ? request.resource.data.referredBy : null;
      return newRef == null || (newRef is string && newRef != userId);
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if isBoundedIncrement('referralsCount', 100)
                    && isBoundedIncrement('referralCount', 100)
                    && isBoundedIncrement('earnedReferralCoins', 50000)
                    && isBoundedIncrement('balanceKitty', 100000)
                    && isBoundedIncrement('balanceUsdt', 100)
                    && isValidMilestoneUpdate()
                    && isReferredByValidTransition(userId);
      allow delete: if false;
    }

    match /referrals/{referralId} {
      allow read: if true;
      allow create, update: if request.resource.data.referrerId is string
                            && request.resource.data.referredId is string
                            && request.resource.data.referrerId != request.resource.data.referredId;
      allow delete: if false;
    }

    match /pending_referrals/{docId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }

    match /users/{userId}/task_completions/{taskId} {
      allow read, write: if true;
    }

    match /swaps/{swapId} {
      allow read, write: if true;
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    match /early_users/{userId} {
      allow read, write: if true;
    }

    match /system/{docId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
