rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Validate bounded increment on numeric fields so arbitrary huge coin writes are blocked
    function isBoundedIncrement(field, maxDelta) {
      let oldVal = resource != null && field in resource.data ? resource.data[field] : 0;
      let newVal = field in request.resource.data ? request.resource.data[field] : 0;
      return newVal is number && (newVal - oldVal) <= maxDelta;
    }

    // Helper: Validate claimedMilestones only appends at most 1 valid milestone ID at a time
    function isValidMilestoneUpdate() {
      let oldList = resource != null && 'claimedMilestones' in resource.data ? resource.data.claimedMilestones : [];
      let newList = 'claimedMilestones' in request.resource.data ? request.resource.data.claimedMilestones : [];
      return newList is list && newList.size() <= 10 && (newList.size() == oldList.size() || newList.size() == oldList.size() + 1);
    }

    // Helper: Prevent overwriting referredBy once it is already set
    function isReferredByImmutableOnceSet() {
      let oldRef = resource != null && 'referredBy' in resource.data ? resource.data.referredBy : null;
      let newRef = 'referredBy' in request.resource.data ? request.resource.data.referredBy : null;
      return oldRef == null || newRef == oldRef;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.id == userId
                    && (!('referralsCount' in request.resource.data) || request.resource.data.referralsCount <= 1)
                    && (!('balanceKitty' in request.resource.data) || request.resource.data.balanceKitty <= 5000);
      allow update: if isBoundedIncrement('referralsCount', 1)
                    && isBoundedIncrement('referralCount', 1)
                    && isBoundedIncrement('earnedReferralCoins', 10000)
                    && isBoundedIncrement('balanceKitty', 25000)
                    && isValidMilestoneUpdate()
                    && isReferredByImmutableOnceSet();
    }

    match /referrals/{referralId} {
      allow read: if true;
      allow create: if request.resource.data.referrerId is string
                    && request.resource.data.referredId is string
                    && request.resource.data.referrerId != request.resource.data.referredId
                    && request.resource.data.rewardAmount == 250
                    && request.resource.data.timestamp is number;
      allow update, delete: if false;
    }

    match /pending_referrals/{docId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }

    match /users/{userId}/task_completions/{taskId} {
      allow read, write: if true;
    }

    match /swaps/{swapId} {
      allow read, write: if true;
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    match /early_users/{userId} {
      allow read, write: if true;
    }

    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
